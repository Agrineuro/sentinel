# Account access is initialized in the dashboard on first visit.
# Keep VAULT_KEY unchanged; encrypted connector credentials cannot be read with a different key.
ENVIRONMENT=production
VAULT_KEY=replace_with_a_random_secret

# Local-only by default. Set to 0.0.0.0 only behind a trusted LAN or HTTPS reverse proxy.
SENTINEL_BIND=127.0.0.1
SENTINEL_PORT=8080
HEALTH_POLL_INTERVAL_SECONDS=30
